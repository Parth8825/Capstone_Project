<%- include('layouts/header'); -%>
<link href="/css/login.css" rel="stylesheet"></head>
<body><header><h2>Employee Management System</h2></header>
<main class="loginBody"><div class="container" style="display:flex;max-width:95%;"><div class="form form--login"><h2 class="form--heading">Administrator login</h2>
<% if (locals.loginError) { %><p><%= loginError %></p><% } %>
<form class="loginForm" method="post" action="/login">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Username <input name="username" autocomplete="username" required></label>
<label>Password <input name="password" type="password" autocomplete="current-password" required></label>
<button class="button" style="margin:10px" type="submit">Login</button>
</form><a href="/verifyEmail">Forgot password?</a>
<p>Contact your administrator for an account.</p><img src="/images/logo.png" alt="PRT logo" class="logo"></div></div></main>
<%- include('layouts/footer'); -%>
